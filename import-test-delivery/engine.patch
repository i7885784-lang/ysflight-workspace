+ uniform sampler2D diffuseMap,normalMap,specularMap,aoMap,alphaMap;
+ uniform bool hasDiffuse,hasNormal,hasSpecular,hasAo,hasAlpha;
+ uniform vec3 kd;uniform float opacity;
+ vec3 srgbToLinear(vec3 c){return mix(c/12.92,pow((c+0.055)/1.055,vec3(2.4)),step(vec3(0.04045),c));}
+ vec3 linearToSrgb(vec3 c){c=max(c,vec3(0.0));return mix(c*12.92,1.055*pow(c,vec3(1.0/2.4))-0.055,step(vec3(0.0031308),c));}
+ void main(){
+ vec4 color=hasDiffuse?texture2D(diffuseMap,uv):vec4(kd,1.0);
+ float a=color.a*opacity;if(hasAlpha)a*=texture2D(alphaMap,uv).r;if(a<0.025)discard;
+ vec3 N=normalize(normal);if(!gl_FrontFacing)N=-N;
+ if(hasNormal){
+ vec3 dp1=dFdx(eyePosition),dp2=dFdy(eyePosition);vec2 dt1=dFdx(uv),dt2=dFdy(uv);
+ vec3 p2=cross(dp2,N),p1=cross(N,dp1);vec3 T=p2*dt1.x+p1*dt2.x,B=p2*dt1.y+p1*dt2.y;
+ float len=max(dot(T,T),dot(B,B));if(len>0.00000001){float inv=inversesqrt(len);vec3 bump=texture2D(normalMap,uv).xyz*2.0-1.0;N=normalize(mat3(T*inv,B*inv,N)*bump);}}
+ vec3 L=normalize(gl_LightSource[0].position.xyz);float light=0.40+0.60*max(dot(N,L),0.0);
+ float ao=hasAo?texture2D(aoMap,uv).r:1.0;float spec=hasSpecular?texture2D(specularMap,uv).r:0.0;
+ vec3 H=normalize(L+normalize(-eyePosition));float shine=pow(max(dot(N,H),0.0),32.0)*spec*0.18;
+ gl_FragColor=vec4(linearToSrgb(srgbToLinear(color.rgb)*light*(0.55+0.45*ao)+vec3(shine)),a);
+ }
+ )GLSL";
+ GLuint vsId=shader(GL_VERTEX_SHADER,vs),fsId=shader(GL_FRAGMENT_SHADER,fs);if(!vsId||!fsId)return false;
+ program=pCreateProgram();pAttachShader(program,vsId);pAttachShader(program,fsId);pLinkProgram(program);
+ GLint ok;pGetProgramiv(program,GL_LINK_STATUS,&ok);if(!ok){printf("IMPORT shader link failed\n");return false;}
+ std::ifstream in(std::string(base)+"aircraft.mesh",std::ios::binary);char magic[8];uint32_t nv=0,ni=0;
+ in.read(magic,8);in.read((char*)&nv,4);in.read((char*)&ni,4);
+ if(!in || std::string(magic,8)!="YSOBJ001" || nv>2000000 || ni>10000000)return false;
+ std::vector<Vertex> vertices(nv);std::vector<uint32_t> indices(ni);
+ in.read((char*)vertices.data(),vertices.size()*sizeof(Vertex));in.read((char*)indices.data(),indices.size()*4);if(!in)return false;
+ for(auto index:indices)if(index>=nv)return false;
+ std::ifstream info(std::string(base)+"aircraft.materials");unsigned nm;info>>nm;if(!info||nm>256)return false;
+ materials.resize(nm);size_t sum=0;
+ for(auto &m:materials){info>>m.count>>m.offset>>m.alpha>>m.kd[0]>>m.kd[1]>>m.kd[2];if(m.offset+m.count>ni)return false;sum+=m.count;for(int i=0;i<5;++i){std::string path;info>>path;m.tex[i]=texture(path);if(path!="-"&&!m.tex[i])return false;}}
+ if(!info||sum!=ni)return false;
+ pGenBuffers(1,&vbo);pBindBuffer(GL_ARRAY_BUFFER,vbo);pBufferData(GL_ARRAY_BUFFER,vertices.size()*sizeof(Vertex),vertices.data(),GL_STATIC_DRAW);
+ pGenBuffers(1,&ibo);pBindBuffer(GL_ELEMENT_ARRAY_BUFFER,ibo);pBufferData(GL_ELEMENT_ARRAY_BUFFER,indices.size()*4,indices.data(),GL_STATIC_DRAW);
+ pBindBuffer(GL_ARRAY_BUFFER,0);pBindBuffer(GL_ELEMENT_ARRAY_BUFFER,0);
+ printf("IMPORT READY vertices=%u triangles=%u materials=%u textures=%u; static pose\n",nv,ni/3,nm,(unsigned)textures.size());fflush(stdout);return true;
+}
