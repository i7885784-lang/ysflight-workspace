+}
+static GLuint shader(GLenum type,const char *src)
+{
+ GLuint id=pCreateShader(type);pShaderSource(id,1,&src,nullptr);pCompileShader(id);
+ GLint ok=0;pGetShaderiv(id,GL_COMPILE_STATUS,&ok);
+ if(!ok){char log[4096];pGetShaderInfoLog(id,sizeof(log),nullptr,log);printf("IMPORT shader error %s\n",log);return 0;}
+ return id;
+}
+static bool load()
+{
