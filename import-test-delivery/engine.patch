+ GLint limit=0;glGetIntegerv(GL_MAX_TEXTURE_SIZE,&limit);
+ if(bmp.GetWidth()>limit || bmp.GetHeight()>limit){printf("IMPORT original texture exceeds GPU limit: %s (%dx%d, limit %d); no silent downsampling\n",name.c_str(),bmp.GetWidth(),bmp.GetHeight(),limit);return 0;}
